# Copia este archivo como .env y arranca: estos valores funcionan tal cual
# en local. Lo que hay que cambiar para producción está marcado abajo.
#
# El .env NUNCA se sube al repositorio.

# --- Django -----------------------------------------------------------
# PRODUCCIÓN: genera una cadena larga y aleatoria, y pon DEBUG en false.
DJANGO_SECRET_KEY=solo-para-desarrollo-cambiar-en-produccion
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# Orígenes desde los que el navegador puede escribir. Sin esto, entrar
# funciona pero el primer POST con sesión falla con 403 y el usuario queda
# encerrado: no puede salir ni volver a entrar.
# PRODUCCIÓN: https://tu-dominio
DJANGO_CSRF_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# --- Base de datos ----------------------------------------------------
DB_NAME=tae
DB_USER=tae_user
DB_PASSWORD=tae_password
DB_HOST=db
DB_PORT=3306
# PRODUCCIÓN: contraseña de root de MySQL, distinta a DB_PASSWORD. La usan
# deploy/docker-compose.prod.yml y deploy/respaldo.sh.
DB_ROOT_PASSWORD=

REDIS_URL=redis://cache:6379/0

# --- Reglas de negocio. Se ajustan sin volver a desplegar. -------------
TAE_AJUSTE_FAVOR_TOPE=5000.00
TAE_TRASPASO_UMBRAL_2FA=50000.00
TAE_TRASPASO_TOPE_DIARIO=500000.00

# --- Correo saliente --------------------------------------------------
# En local se imprime en la consola; así el restablecimiento se puede
# probar sin servidor de correo.
# PRODUCCIÓN: cambia el backend a smtp y llena EMAIL_HOST y credenciales.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-responder@eps.mx

TAE_URL_BASE=http://localhost:5173
TAE_RESTABLECIMIENTO_HORAS=1

# --- Proveedor (axexo / Integrator API) --------------------------------
# real: habla con axexo. simulado: el emulador dentro del proceso, para
# desarrollar sin red ni credenciales (decisión 18). Con DJANGO_DEBUG=false
# la aplicación NO arranca en modo simulado.
PROVEEDOR_MODO=simulado

# Valores de la hoja de credenciales. Solo hacen falta con PROVEEDOR_MODO=real.
# La base es el host SIN ruta: el login vive en /api/v1/auth/login.
#   UAT: https://gw-uat.axexo.com:10002
PROVEEDOR_BASE_URL=
PROVEEDOR_USUARIO=
PROVEEDOR_CONTRASENA=
# Site-Id: el "Terminal ID" de la hoja de axexo. Va en todas las llamadas.
PROVEEDOR_SITE_ID=
# Clerk-Id: va en todas las llamadas.
PROVEEDOR_CLERK_ID=
# Merchant-Id: solo en la consulta de saldo (account/balance).
PROVEEDOR_MERCHANT_ID=
PROVEEDOR_LANGUAGE=2
# Prefijo de las operaciones (topup, lookup). La hoja de axexo pone el "End
# Point" en /integratorapi: si las ventas responden 404, prueba con
# /integratorapi. CONFIRMAR con axexo.
PROVEEDOR_PREFIJO_OPERACIONES=
# Prefijo del login (vacío o /integratorapi) y nombre del campo del usuario
# en su cuerpo (email o username). diagnostico_emida.py dice cuáles van.
PROVEEDOR_PREFIJO_LOGIN=
PROVEEDOR_CAMPO_USUARIO=email

# Tiempos indicados por el proveedor: consultar a los 40 segundos del envío
# y luego cada 10. Ajustables sin desplegar.
PROVEEDOR_TIMEOUT_VENTA=30
PROVEEDOR_TIMEOUT_LOOKUP=15
PROVEEDOR_LOOKUP_DESDE_ENVIO=40
PROVEEDOR_ESPERA_ENTRE_LOOKUPS=10
PROVEEDOR_MAX_LOOKUPS=3

# --- Producción -------------------------------------------------------
# Segundos de HSTS. Empieza en 3600 y súbelo a 31536000 cuando el HTTPS
# lleve semanas estable.
DJANGO_HSTS_SEGUNDOS=3600
# Nivel de bitácora de la aplicación: DEBUG, INFO, WARNING, ERROR.
TAE_LOG_NIVEL=INFO

# --- Tareas programadas (contenedor `tareas`) ---------------------------
TAE_INQUILINO=scorpion
# Hora local (America/Mexico_City) de la descarga diaria de productos.
TAE_HORA_CATALOGO=04:00
# Cada cuántos minutos se reintentan las ventas sin resolver.
TAE_REINTENTOS_MINUTOS=5

# --- Instalación de primera vez (manage.py instalar) -------------------
# Contraseña inicial para los cuatro usuarios. Vacía: cada uno recibe una
# aleatoria. En ambos casos deben cambiarla al entrar.
TAE_CLAVE_INICIAL=
TAE_NOMBRE_INQUILINO=Scorpion
TAE_SUPERADMIN_CORREO=superadmin@eps.mx
TAE_SUPERADMIN_NOMBRE=Super Admin
TAE_ADMIN_CORREO=brenda@eps.mx
TAE_ADMIN_NOMBRE=Brenda Lemus
TAE_ADMIN_ENTIDAD=Scorpion
TAE_CLIENTE_CORREO=jorge@laermita.mx
TAE_CLIENTE_NOMBRE=Jorge Rivas
TAE_CLIENTE_ENTIDAD=Abarrotes La Ermita
TAE_CLIENTE_MARGEN=4
TAE_CAJA_CORREO=luis@laermita.mx
TAE_CAJA_NOMBRE=Luis Canul
TAE_CAJA_ENTIDAD=Caja Mostrador
